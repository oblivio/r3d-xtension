# ─── LLM Provider (at least one required for AI features) ─────────────
# The proxy routes to whichever provider has keys set.
# Model selection, temperature, and token limits are handled here —
# the Chrome extension never sees these values.

# Azure OpenAI (recommended for enterprise)
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-08-01-preview

# Google Gemini
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# ─── LLM Model ───────────────────────────────────────────────────────
# Prefix determines the provider:
#   azure/your-deployment-name    → Azure OpenAI
#   gemini/gemini-2.5-pro         → Google Gemini
#   gpt-4o                        → OpenAI
R3D_MODEL=azure/gpt-4.1-mini

# ─── Proxy Auth ──────────────────────────────────────────────────────
# The extension auto-discovers this via /r3d/handshake — no pasting needed.
# Leave blank to auto-generate a secure key on each `docker compose up`.
# Set a custom value only if you need a stable key across restarts.
R3D_API_KEY=

# ─── CSFLE / Queryable Encryption ───────────────────────────────────
# 96-byte base64-encoded local master key.  The demo key below is the
# deterministic bytes [0..95] — fine for local dev, NEVER use in prod.
# docker-compose.yml already sets this; override here only if needed.
# LOCAL_MASTER_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0+P0BBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWltcXV5f

# Path to the MongoDB crypt_shared library.  Set by the Dockerfile; only
# override if you installed it somewhere else.
# CRYPT_SHARED_LIB_PATH=/opt/mongodb/lib/mongo_crypt_v1.so
